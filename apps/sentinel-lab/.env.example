# Primary Vercel-native execution path. Never prefix secrets with NEXT_PUBLIC_.
EIDOS_EXECUTION_BACKEND=sandbox
EIDOS_OPERATOR_TOKEN=replace-with-a-separate-operator-secret
# Optional approved pilot keys. Store only SHA-256 digests, never raw keys.
# Remove a grant to revoke it; expired grants fail closed.
EIDOS_TEST_ACCESS_GRANTS=[{"id":"pilot-01","sha256":"replace-with-64-lowercase-hex-characters","expiresAt":"2026-12-31T23:59:59.000Z"}]
KAGGLE_API_TOKEN=replace-with-your-kaggle-token

# Conservative Sandbox budgets. Hobby supports 4 vCPU / 8 GB and up to 45 minutes.
EIDOS_SANDBOX_VCPUS=4
EIDOS_SANDBOX_TIMEOUT_MS=2700000
EIDOS_SANDBOX_MAX_ROWS=25000
EIDOS_MAX_CONCURRENT_JOBS=1

# Git deployments receive VERCEL_GIT_COMMIT_SHA automatically. Set this only
# for a non-Git/manual deployment, and always use an exact 40-character SHA.
EIDOS_SOURCE_COMMIT=
EIDOS_SOURCE_REPOSITORY=https://github.com/bmparent/eidos.git

# Optional fallback: set EIDOS_EXECUTION_BACKEND=external and configure both.
EIDOS_RUNNER_URL=https://runner.example.com
EIDOS_RUNNER_TOKEN=replace-with-a-long-random-secret
EIDOS_PUBLICATION_FEED_URL=https://eidosworks.pages.dev/insights-feed.json

# Vercel control-plane connection. Never prefix these with NEXT_PUBLIC_.
EIDOS_RUNNER_URL=https://runner.example.com
EIDOS_RUNNER_TOKEN=replace-with-a-long-random-secret
EIDOS_OPERATOR_TOKEN=replace-with-a-separate-operator-secret

# Optional on Vercel for authenticated/private Kaggle catalog lookup.
# The actual dataset download token belongs on the runner.
KAGGLE_API_TOKEN=
